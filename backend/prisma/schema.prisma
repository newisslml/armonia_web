generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  nombre       String?
  telefono     String?
  direccion    String?
  rol          String    @default("cliente") // cliente | admin
  creadoEn     DateTime  @default(now())
  carrito      Carrito?
  pedidos      Pedido[]
}

model Categoria {
  id        Int         @id @default(autoincrement())
  nombre    String
  slug      String      @unique
  padreId   Int?
  padre     Categoria?  @relation("Subcategorias", fields: [padreId], references: [id])
  hijos     Categoria[] @relation("Subcategorias")
  productos Producto[]
}

model Producto {
  id           Int           @id @default(autoincrement())
  nombre       String
  slug         String        @unique
  descripcion  String?
  precio       Decimal       @db.Decimal(10, 2)
  stock        Int           @default(0)
  categoriaId  Int?
  categoria    Categoria?    @relation(fields: [categoriaId], references: [id])
  destacado    Boolean       @default(false)
  imagenUrl    String?
  creadoEn     DateTime      @default(now())
  carritoItems CarritoItem[]
  pedidoItems  PedidoItem[]
}

model Carrito {
  id        Int           @id @default(autoincrement())
  usuarioId Int?          @unique
  usuario   Usuario?      @relation(fields: [usuarioId], references: [id])
  sessionId String?       @unique
  creadoEn  DateTime      @default(now())
  items     CarritoItem[]
}

model CarritoItem {
  id         Int      @id @default(autoincrement())
  carritoId  Int
  carrito    Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int

  @@unique([carritoId, productoId])
}

model Pedido {
  id             Int          @id @default(autoincrement())
  usuarioId      Int
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])
  estado         String       @default("pendiente") // pendiente | pagado | rechazado | enviado | completado
  total          Decimal      @db.Decimal(10, 2)
  direccionEnvio String
  creadoEn       DateTime     @default(now())
  items          PedidoItem[]
  pago           Pago?
}

model PedidoItem {
  id             Int      @id @default(autoincrement())
  pedidoId       Int
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
}

model Pago {
  id             Int      @id @default(autoincrement())
  pedidoId       Int      @unique
  pedido         Pedido   @relation(fields: [pedidoId], references: [id])
  proveedor      String   @default("transbank")
  tokenTransbank String?
  estado         String   @default("iniciado") // iniciado | autorizado | rechazado | anulado
  monto          Decimal  @db.Decimal(10, 2)
  creadoEn       DateTime @default(now())
}

model NewsletterSuscriptor {
  email      String   @id
  confirmado Boolean  @default(false)
  creadoEn   DateTime @default(now())
}
